#!/usr/bin/env python3
"""claimlock launcher. The package lives in ../lib so the plugin exposes one command.

Everything above the package import must parse and run on old interpreters
(Python 3.6+): the version guard is useless if the file fails to parse first.
"""
import os
import sys

if sys.version_info < (3, 11):
    found = "%d.%d" % tuple(sys.version_info[:2])
    if sys.argv[1:2] == ["hook"]:
        # A hook must never fail loudly: exit 2 from Stop blocks Claude from
        # stopping, and from PostToolUse feeds stderr to the model. Record the
        # reason where hook errors go, print nothing, and exit 0.
        data = os.environ.get("CLAUDE_PLUGIN_DATA")
        if data:
            try:
                import datetime
                os.makedirs(data, exist_ok=True)
                log_path = os.path.join(data, "hook-errors.log")
                # Unbounded on every hook invocation otherwise: skip the
                # append once the file is already over 1 MiB rather than
                # growing it forever (there is no lib/ import available yet
                # on this old-Python path to share hooks.py's own cap).
                try:
                    oversized = os.stat(log_path).st_size > 1024 * 1024
                except OSError:
                    oversized = False
                if not oversized:
                    with open(log_path, "a") as f:
                        f.write("%s hook %s: claimlock needs Python 3.11+ (found %s); hook skipped\n"
                                % (datetime.datetime.now().isoformat(), " ".join(sys.argv[2:3]), found))
            except Exception:
                pass
        sys.exit(0)
    sys.stderr.write("claimlock: needs Python 3.11+ (found %s)\n" % found)
    sys.exit(2)

from pathlib import Path  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from claimlock.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
